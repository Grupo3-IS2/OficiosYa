# Copy to .env and adjust. The app always runs on PostgreSQL; the "db" service
# in docker-compose.yml provides it.

# Port the app listens on inside its container.
SERVER_PORT=8080

# Loopback port the Spring Boot container is published on. The host's nginx
# proxies /api and /ws to it and serves the React build from
# /var/www/oficiosya/<release|dev>. Use 8080 for ~/release and 8081 for ~/dev.
APP_PORT=8080

# --- Database ---
# DB_PASSWORD cannot be empty: Postgres refuses to initialize without it.
DB_NAME=oficiosya
DB_USERNAME=oficiosya
DB_PASSWORD=changeme
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Only used when the backend runs outside Docker (against a Postgres you run
# yourself). Inside Docker, compose overrides it with db:5432.
DB_HOST=localhost:5432

# --- Web ---
# Host without scheme; CORS allows both http:// and https://
WEB_URL=localhost

# --- Auth ---
# If these files do not exist, a temporary RSA pair is generated on every start
# (tokens stop being valid after a restart). To generate them:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/private_jwt.pem
#   openssl rsa -in keys/private_jwt.pem -pubout -out keys/public_jwt.pem
#   chmod 644 keys/*.pem   # the container runs as uid 1001 and must be able to read them
# Docker mounts them at /app/keys and overrides these paths.
JWT_PRIVATE_KEY_PATH=keys/private_jwt.pem
JWT_PUBLIC_KEY_PATH=keys/public_jwt.pem
JWT_EXPIRATION_TIME=3600000
