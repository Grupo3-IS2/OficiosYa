# Copy to .env and adjust. A single set of variables covers the three ways of
# running the project: local H2, external Postgres and Docker.

# local = embedded H2 under ./data (no external server) | postgres = PostgreSQL
# Docker ignores this variable: docker-compose.yml forces the "postgres" profile.
APP_PROFILE=local

# Port the app listens on; APP_PORT is the host port Docker maps to 8080.
SERVER_PORT=8080
APP_PORT=8080

# --- Database ---
# Used by all three modes. With APP_PROFILE=local, DB_NAME is the name of the
# H2 file (./data/<DB_NAME>.mv.db) and the user/password pair is fixed the
# first time that file is created.
# DB_PASSWORD cannot be empty: Postgres refuses to initialize without it.
DB_NAME=oficiosya
DB_USERNAME=oficiosya
DB_PASSWORD=changeme
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Only for APP_PROFILE=postgres outside Docker.
# Inside Docker, compose overrides it with db:5432.
DB_HOST=localhost:5432

# --- Web ---
# Host without scheme; CORS allows both http:// and https://
WEB_URL=localhost

# --- Auth ---
# If these files do not exist, a temporary RSA pair is generated on every start
# (tokens stop being valid after a restart). To generate them:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/private_jwt.pem
#   openssl rsa -in keys/private_jwt.pem -pubout -out keys/public_jwt.pem
#   chmod 644 keys/*.pem   # the container runs as uid 1001 and must be able to read them
# Docker mounts them at /app/keys and overrides these paths.
JWT_PRIVATE_KEY_PATH=keys/private_jwt.pem
JWT_PUBLIC_KEY_PATH=keys/public_jwt.pem
JWT_EXPIRATION_TIME=3600000
