# Copy to .env and adjust. The app always runs on PostgreSQL; the "db" service
# in docker-compose.yml provides it.

# Port the app listens on inside its container.
SERVER_PORT=8080

# Loopback port the Spring Boot container is published on. The host's nginx
# proxies /api and /ws to it and serves the React build from the clone's
# frontend/dist. Use 8080 for ~/storage/oficios-ya/release and 8081 for .../dev.
APP_PORT=8080

# --- Database ---
# DB_PASSWORD cannot be empty: Postgres refuses to initialize without it.
DB_NAME=oficiosya
DB_USERNAME=oficiosya
DB_PASSWORD=changeme
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Only used when the backend runs outside Docker (against a Postgres you run
# yourself). Inside Docker, compose overrides it with db:5432.
DB_HOST=localhost:5432

# --- Web ---
# Host without scheme; CORS allows both http:// and https://
WEB_URL=localhost

# --- API docs ---
# Swagger UI at /swagger-ui.html and OpenAPI JSON at /v3/api-docs.
# Set to false in production to disable both.
SWAGGER_ENABLED=true

# --- Auth ---
# If these files do not exist, a temporary RSA pair is generated on every start
# (tokens stop being valid after a restart). To generate them:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/private_jwt.pem
#   openssl rsa -in keys/private_jwt.pem -pubout -out keys/public_jwt.pem
#   chmod 644 keys/*.pem   # the container runs as uid 1001 and must be able to read them
# Docker mounts them at /app/keys and overrides these paths.
JWT_PRIVATE_KEY_PATH=keys/private_jwt.pem
JWT_PUBLIC_KEY_PATH=keys/public_jwt.pem
JWT_EXPIRATION_TIME=3600000

# --- Mail (verification codes) ---
# Sent when someone registers. Locally, `docker compose --profile dev up` starts
# Mailpit, a fake inbox at http://localhost:8025: leave SMTP_HOST unset and the app
# container uses it. Outside dev set a real SMTP provider, e.g. for Gmail (with an
# app password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<app password>
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
# Do not set SMTP_HOST=localhost for the container: inside it, localhost is the
# container itself. A backend run outside Docker already defaults to localhost:1025.
#SMTP_HOST=
#SMTP_PORT=1025
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_AUTH=false
#SMTP_STARTTLS=false
# The shared dev server keeps Mailpit running too and shows it at /mailpit/ (see
# nginx/oficios-ya-dev.conf). In that clone's .env, and nowhere else:
#COMPOSE_PROFILES=mail
#MAILPIT_WEBROOT=mailpit
# Sender of those emails. Use an address on a domain with SPF/DKIM set up or
# they end up in spam.
MAIL_FROM=no-reply@oficiosya.com

# --- Google sign-in ---
# The OAuth Client ID (type "Web application") from Google Cloud Console
# Left empty, sign-in with Google is disabled.
GOOGLE_CLIENT_ID=

# --- Verification codes ---
# Mixed into every code's hash. Set a long random value anywhere but local
# development (e.g. `openssl rand -hex 32`); the app warns at startup if it is not set.
VERIFICATION_SECRET=
# Digits of the code, minutes it stays valid, wrong tries allowed, and seconds
# before another code can be requested for the same email.
VERIFICATION_CODE_LENGTH=6
VERIFICATION_EXPIRATION_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Requests per minute one IP can make to the endpoints that mail or check a code
# (register-*, verify-email, resend-code). Raise it for automated tests.
#RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Default administrator ---
# Created on startup if it doesn't exist yet. ADMIN_PASSWORD has no default:
# leave it unset and no admin account is created at all.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@oficiosya.com
ADMIN_PASSWORD=
