# Copy to .env and adjust. Every variable is optional: the defaults in
# application.properties are enough to run the app locally with H2.

# local = embedded H2 (no external server) | postgres = external PostgreSQL
APP_PROFILE=local
SERVER_PORT=8080

# --- Database ---
DB_NAME=db
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Only for APP_PROFILE=postgres
DB_HOST=localhost:5432

# --- Web ---
# Host without scheme; http:// and https:// are allowed by CORS
WEB_URL=localhost

# --- Auth ---
# If these files do not exist, a temporary RSA key pair is generated at startup
JWT_PRIVATE_KEY_PATH=private_jwt.pem
JWT_PUBLIC_KEY_PATH=public_jwt.pem
JWT_EXPIRATION_TIME=3600000
